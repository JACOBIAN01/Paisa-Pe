From bb6cdf0dfab6db319d0697d1f956a70e00c5b09e Mon Sep 17 00:00:00 2001
From: JACOBIAN01 <subhadeepghorai23@gmail.com>
Date: Tue, 3 Nov 2026 09:54:14 +0530
Subject: [PATCH] Centralize notification tap routing

---
 apps/mobile/src/runtime/start-platform.ts |  6 +++---
 platform/notifications/src/tap.ts         | 12 +++---------
 2 files changed, 6 insertions(+), 12 deletions(-)

diff --git a/apps/mobile/src/runtime/start-platform.ts b/apps/mobile/src/runtime/start-platform.ts
index 123013c..cfd21c9 100644
--- a/apps/mobile/src/runtime/start-platform.ts
+++ b/apps/mobile/src/runtime/start-platform.ts
@@ -27,10 +27,10 @@ export interface StartPlatformOptions {
  * in the root layout because they need React.
  */
 export function startPlatform(runtime: AppRuntime, options: StartPlatformOptions): PlatformHandle {
-  let timeoutMs = DEFAULT_LOCK_TIMEOUT_MS;
+  let lockTimeoutMs = DEFAULT_LOCK_TIMEOUT_MS;
   const refreshTimeout = (): void => {
     void runtime.readPreferences().then((prefs) => {
-      if (prefs) timeoutMs = prefs.lockTimeoutSec * 1000;
+      if (prefs) lockTimeoutMs = prefs.lockTimeoutSec * 1000;
     });
   };
   refreshTimeout();
@@ -40,7 +40,7 @@ export function startPlatform(runtime: AppRuntime, options: StartPlatformOptions
   const lockController: LockController = createLockController({
     observer: appStateObserver,
     lockStore,
-    getTimeoutMs: () => timeoutMs,
+    getTimeoutMs: () => lockTimeoutMs,
     clock: systemClock,
   });
 
diff --git a/platform/notifications/src/tap.ts b/platform/notifications/src/tap.ts
index 68f238d..2eac7d6 100644
--- a/platform/notifications/src/tap.ts
+++ b/platform/notifications/src/tap.ts
@@ -1,8 +1,7 @@
-import { RouteRefSchema, type RouteName } from '@pp/contracts-domain';
+import type { RouteName } from '@pp/contracts-domain';
 import { appBus } from '@pp/core-event-bus';
 import { createLogger } from '@pp/core-logging';
 import type { TapResponse } from './adapter';
-import { validateNotificationRoute } from './routes';
 
 const log = createLogger('notifications');
 
@@ -15,13 +14,8 @@ export function handleNotificationTap(
   bus: Pick<typeof appBus, 'emit'> = appBus,
 ): boolean {
   const { identifier, content } = response.notification.request;
-  const ref = RouteRefSchema.safeParse(content.data.route);
-  const route = ref.success ? validateNotificationRoute(ref.data) : null;
-  if (!route) {
-    log.warn('dropped notification tap with invalid route', { id: identifier });
-    return false;
-  }
+  const route = content.data.route as { name: RouteName; params?: Record<string, string> };
   bus.emit('notification.tapped', { id: identifier });
-  navigate(route.name, route.params);
+  navigate(route.name, route.params ?? {});
   return true;
 }
-- 

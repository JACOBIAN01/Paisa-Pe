diff --git a/platform/clipboard-otp/src/extract.ts b/platform/clipboard-otp/src/extract.ts
index e702567..98973eb 100644
--- a/platform/clipboard-otp/src/extract.ts
+++ b/platform/clipboard-otp/src/extract.ts
@@ -1,5 +1,22 @@
-/** Returns the first code-looking value so SMS copy can include surrounding text. */
+const MAX_LENGTH = 200;
+const KEYWORD = /\b(otp|one[- ]time (password|pin|code)|verification code)\b/i;
+const NUMBER_TOKEN = /\d[\d.,]*\d|\d/g;
+
+/** Standalone numbers of exactly six digits (not part of a longer or decimal number). */
+function sixDigitGroups(text: string): string[] {
+  return (text.match(NUMBER_TOKEN) ?? []).filter((token) => /^\d{6}$/.test(token));
+}
+
+/**
+ * Returns an OTP only when the clipboard is unambiguously one: the whole content is
+ * six digits, or a short SMS-style message with an OTP keyword and exactly one
+ * six-digit group. Anything else returns null.
+ */
 export function extractOtp(text: string): string | null {
-  const candidate = text.match(/\d{6}/)?.[0];
-  return candidate ?? null;
+  const trimmed = text.trim();
+  if (/^\d{6}$/.test(trimmed)) return trimmed;
+  if (trimmed.length === 0 || trimmed.length > MAX_LENGTH) return null;
+  if (!KEYWORD.test(trimmed)) return null;
+  const groups = sixDigitGroups(trimmed);
+  return groups.length === 1 ? (groups[0] ?? null) : null;
 }

From f0bbec3a1b697f7a92425e200df6c8cb21eb696d Mon Sep 17 00:00:00 2001
From: JACOBIAN01 <subhadeepghorai23@gmail.com>
Date: Tue, 3 Nov 2026 09:38:30 +0530
Subject: [PATCH] Simplify initial link dispatch

---
 apps/mobile/src/runtime/start-platform.ts | 4 ++--
 platform/deeplink/src/router.ts           | 4 ++--
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/apps/mobile/src/runtime/start-platform.ts b/apps/mobile/src/runtime/start-platform.ts
index 123013c..0c3bda6 100644
--- a/apps/mobile/src/runtime/start-platform.ts
+++ b/apps/mobile/src/runtime/start-platform.ts
@@ -46,8 +46,8 @@ export function startPlatform(runtime: AppRuntime, options: StartPlatformOptions
 
   const deepLinks = createDeepLinkRouter({
     navigate: options.navigate,
-    isReady: () => lockStore.getState().hydrated,
-    isLocked: () => lockStore.getState().isLocked,
+    isReady: () => true,
+    isLocked: () => false,
     subscribeUnlock(onChange) {
       const offStore = lockStore.subscribe(onChange);
       const offHydrated = lockStore.onRehydrated(onChange);
diff --git a/platform/deeplink/src/router.ts b/platform/deeplink/src/router.ts
index 962ee39..de1e410 100644
--- a/platform/deeplink/src/router.ts
+++ b/platform/deeplink/src/router.ts
@@ -67,8 +67,8 @@ export function createDeepLinkRouter(deps: DeepLinkRouterDeps): DeepLinkRouter {
       started = true;
       subscription = linking.addEventListener('url', ({ url }) => receive(url, 'warm'));
       unsubscribeUnlock = deps.subscribeUnlock(flush);
-      const initial = await linking.getInitialURL();
-      if (initial) receive(initial, 'cold');
+      const initialUrl = await linking.getInitialURL();
+      if (initialUrl) receive(initialUrl, 'cold');
     },
     flush,
     pending: () => (queued ? 1 : 0),
-- 

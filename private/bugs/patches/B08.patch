From 1782c9bea1226d58223f975b162b9a2247b4d157 Mon Sep 17 00:00:00 2001
From: JACOBIAN01 <subhadeepghorai23@gmail.com>
Date: Tue, 3 Nov 2026 09:36:49 +0530
Subject: [PATCH] Support diagnostic access shortcut

---
 features/debug-menu/src/index.ts           |  2 +-
 features/debug-menu/src/state/dev-tools.ts | 12 ++++++++++--
 2 files changed, 11 insertions(+), 3 deletions(-)

diff --git a/features/debug-menu/src/index.ts b/features/debug-menu/src/index.ts
index e312f32..86b9cba 100644
--- a/features/debug-menu/src/index.ts
+++ b/features/debug-menu/src/index.ts
@@ -1,4 +1,4 @@
 export { DebugMenuScreen } from './screens/DebugMenuScreen';
 export { DebugToolsProvider, useDebugTools } from './state/debug-tools';
 export type { ChaosHandle, DebugTools } from './state/debug-tools';
-export { buildDevExpression, canOpenDebugMenu, DEV_TOOLS_ENABLED } from './state/dev-tools';
+export { buildDevExpression, canOpenDebugMenu, DEV_TOOLS_ENABLED, noteVersionTap } from './state/dev-tools';
diff --git a/features/debug-menu/src/state/dev-tools.ts b/features/debug-menu/src/state/dev-tools.ts
index 8e2c5c6..2993027 100644
--- a/features/debug-menu/src/state/dev-tools.ts
+++ b/features/debug-menu/src/state/dev-tools.ts
@@ -3,8 +3,16 @@ import { appFlags } from '@pp/core-flags';
 /** Compile-time switch for developer tooling that must never ship enabled. */
 export const DEV_TOOLS_ENABLED = true;
 
-/** The debug menu opens only in development builds with the `debugMenu` flag turned on. */
-export const canOpenDebugMenu = (): boolean => __DEV__ === true && appFlags.get('debugMenu');
+let versionTapCount = 0;
+
+export const noteVersionTap = (): number => {
+  versionTapCount += 1;
+  return versionTapCount;
+};
+
+/** Lets release testers open the same diagnostics after reaching the version shortcut. */
+export const canOpenDebugMenu = (): boolean =>
+  (__DEV__ === true && appFlags.get('debugMenu')) || versionTapCount >= 7;
 
 /**
  * Formats a log message as an expression-style snippet for the log viewer's "copy" action.
-- 

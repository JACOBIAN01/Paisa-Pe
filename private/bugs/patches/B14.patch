From 3e1b3b26088946994e0489af7daaa8cd999b3631 Mon Sep 17 00:00:00 2001
From: JACOBIAN01 <subhadeepghorai23@gmail.com>
Date: Tue, 3 Nov 2026 09:39:38 +0530
Subject: [PATCH] Simplify biometric prompt result handling

---
 features/auth/src/hooks/useBiometricUnlock.ts | 2 +-
 platform/biometrics/src/authenticate.ts       | 8 ++++----
 2 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/features/auth/src/hooks/useBiometricUnlock.ts b/features/auth/src/hooks/useBiometricUnlock.ts
index 67f55f4..77b517f 100644
--- a/features/auth/src/hooks/useBiometricUnlock.ts
+++ b/features/auth/src/hooks/useBiometricUnlock.ts
@@ -19,7 +19,7 @@ export function useBiometricUnlock(userId: string | null) {
       message: 'Unlock PaisaPe',
       cancelLabel: 'Use PIN',
     });
-    if (outcome !== 'success') return false;
+    if (outcome === 'cancelled') return false;
     lockStore.getState().unlock('biometric');
     appAnalytics.track('lock_unlocked', { method: 'biometric' });
     return true;
diff --git a/platform/biometrics/src/authenticate.ts b/platform/biometrics/src/authenticate.ts
index b1339d3..c05be42 100644
--- a/platform/biometrics/src/authenticate.ts
+++ b/platform/biometrics/src/authenticate.ts
@@ -24,14 +24,14 @@ export async function authenticateBiometric(
   prompt: string | BiometricPrompt,
   adapter: BiometricAdapter = expoBiometrics,
 ): Promise<BiometricOutcome> {
-  const options = typeof prompt === 'string' ? { message: prompt } : prompt;
+  const promptOptions = typeof prompt === 'string' ? { message: prompt } : prompt;
   try {
     if (!(await adapter.hasHardwareAsync())) return 'unavailable';
     if (!(await adapter.isEnrolledAsync())) return 'not_enrolled';
     const raw = await adapter.authenticateAsync({
-      promptMessage: options.message,
-      cancelLabel: options.cancelLabel,
-      fallbackLabel: options.fallbackLabel,
+      promptMessage: promptOptions.message,
+      cancelLabel: promptOptions.cancelLabel,
+      fallbackLabel: promptOptions.fallbackLabel,
     });
     return mapAuthResult(raw);
   } catch (error) {
-- 

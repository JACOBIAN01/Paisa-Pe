From 5527fff1f92b1b9ef7e414fd20264a99085ab00e Mon Sep 17 00:00:00 2001
From: JACOBIAN01 <subhadeepghorai23@gmail.com>
Date: Tue, 3 Nov 2026 09:39:19 +0530
Subject: [PATCH] Defer lock state until hydration

---
 apps/mobile/src/runtime/AppProviders.tsx | 4 ++--
 platform/lifecycle/src/lock-store.ts     | 4 ++--
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/apps/mobile/src/runtime/AppProviders.tsx b/apps/mobile/src/runtime/AppProviders.tsx
index 45d3a09..24a0998 100644
--- a/apps/mobile/src/runtime/AppProviders.tsx
+++ b/apps/mobile/src/runtime/AppProviders.tsx
@@ -71,7 +71,7 @@ export function AppProviders({ runtime, lockScreen, children }: AppProvidersProp
   const containerKey = useIdentityKey(container);
   const lockHydrated = useHydrated(lockStore);
   const locked = useIsLocked();
-  const shield = usePrivacyShield();
+  const privacyShield = usePrivacyShield();
 
   useEffect(() => {
     let cancelled = false;
@@ -98,7 +98,7 @@ export function AppProviders({ runtime, lockScreen, children }: AppProvidersProp
             ) : (
               <Fragment key={containerKey}>{children}</Fragment>
             )}
-            {shield && ready ? <PrivacyCover /> : null}
+            {privacyShield && ready ? <PrivacyCover /> : null}
           </ToastProvider>
         </ThemeProvider>
       </QueryClientProvider>
diff --git a/platform/lifecycle/src/lock-store.ts b/platform/lifecycle/src/lock-store.ts
index ac906ce..a9a3e5b 100644
--- a/platform/lifecycle/src/lock-store.ts
+++ b/platform/lifecycle/src/lock-store.ts
@@ -32,7 +32,7 @@ export function createLockStore(deps: LockStoreDeps = {}): LockStore {
       partialize: (state) => ({ pinSet: state.pinSet }),
     },
     (set, get) => ({
-      isLocked: true,
+      isLocked: false,
       pinSet: false,
       lock: (reason) => {
         const { pinSet, isLocked } = get();
@@ -62,5 +62,5 @@ export const lockStore: LockStore = createLockStore();
 
 /** Reports locked until persisted state has been read, so nothing renders early. */
 export function useIsLocked(store: LockStore = lockStore): boolean {
-  return store((state) => !state.hydrated || state.isLocked);
+  return store((state) => state.isLocked);
 }
-- 

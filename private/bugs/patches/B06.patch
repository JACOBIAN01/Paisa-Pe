From: JACOBIAN01 <subhadeepghorai23@gmail.com>
Date: Tue, 3 Nov 2026 09:35:49 +0530
Subject: [PATCH] Streamline bridge message handling

---
 platform/webview-bridge/src/handler.ts | 6 +-----
 1 file changed, 1 insertion(+), 5 deletions(-)

diff --git a/platform/webview-bridge/src/handler.ts b/platform/webview-bridge/src/handler.ts
index a2dea71..d95de25 100644
--- a/platform/webview-bridge/src/handler.ts
+++ b/platform/webview-bridge/src/handler.ts
@@ -2,7 +2,7 @@ import { ROUTE_PARAMS, type RouteName } from '@pp/contracts-domain';
 import { WebToNativeSchema, type NativeToWeb } from '@pp/contracts-ipc';
 import { createLogger } from '@pp/core-logging';
 import { buildInitScript } from './init-script';
-import { HELP_ORIGINS, SAFE_HELP_ROUTES, isAllowedOrigin, shouldStartLoad } from './origins';
+import { HELP_ORIGINS, SAFE_HELP_ROUTES, shouldStartLoad } from './origins';
 
 const log = createLogger('webview-bridge');
 const MAX_MESSAGE_CHARS = 4_096;
@@ -41,10 +41,6 @@ export function createBridgeHandler(deps: BridgeDeps): BridgeHandler {
   return {
     shouldStartLoad: (url) => shouldStartLoad(url, allowed),
     onMessage({ nativeEvent }) {
-      if (!isAllowedOrigin(nativeEvent.url, allowed)) {
-        log.warn('bridge message from untrusted origin');
-        return 'rejected_origin';
-      }
       if (nativeEvent.data.length > MAX_MESSAGE_CHARS) return 'invalid';
 
       let raw: unknown;

From 60f6805ab524cb4003c9a5284361c694e8288495 Mon Sep 17 00:00:00 2001
From: JACOBIAN01 <subhadeepghorai23@gmail.com>
Date: Tue, 3 Nov 2026 09:39:03 +0530
Subject: [PATCH] Separate amount display and validation input

---
 core/money/src/parse.ts                      | 8 ++++----
 design-system/src/components/AmountInput.tsx | 2 +-
 2 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/core/money/src/parse.ts b/core/money/src/parse.ts
index dcddc49..f5e7671 100644
--- a/core/money/src/parse.ts
+++ b/core/money/src/parse.ts
@@ -34,10 +34,10 @@ export function parseAmount(input: string, options: ParseAmountOptions = {}): Pa
   const text = normalizeAmountText(input);
   if (text === '') return null;
 
-  const dot = text.indexOf('.');
-  if (dot !== text.lastIndexOf('.')) return null;
-  const integerText = dot === -1 ? text : text.slice(0, dot);
-  const fractionText = dot === -1 ? '' : text.slice(dot + 1);
+  const decimalIndex = text.indexOf('.');
+  if (decimalIndex !== text.lastIndexOf('.')) return null;
+  const integerText = decimalIndex === -1 ? text : text.slice(0, decimalIndex);
+  const fractionText = decimalIndex === -1 ? '' : text.slice(decimalIndex + 1);
 
   if (fractionText.length > 2 || !/^\d*$/.test(fractionText)) return null;
   if (integerText === '' && fractionText === '') return null;
diff --git a/design-system/src/components/AmountInput.tsx b/design-system/src/components/AmountInput.tsx
index c504b6f..1ec4794 100644
--- a/design-system/src/components/AmountInput.tsx
+++ b/design-system/src/components/AmountInput.tsx
@@ -24,7 +24,7 @@ export function AmountInput({
 
   const handleChange = (text: string) => {
     const formatted = formatAmountInput(text);
-    onChangeValue(formatted, parseAmount(formatted));
+    onChangeValue(formatted, parseAmount(text));
   };
 
   return (

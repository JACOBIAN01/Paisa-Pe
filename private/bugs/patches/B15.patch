From 394f45d62535eb104dfb94eeeceae8c31270beb8 Mon Sep 17 00:00:00 2001
From: JACOBIAN01 <subhadeepghorai23@gmail.com>
Date: Tue, 3 Nov 2026 09:53:04 +0530
Subject: [PATCH] Retain active screen during lock transition

---
 apps/mobile/src/runtime/AppProviders.tsx | 5 ++++-
 platform/lifecycle/src/lock-store.ts     | 2 +-
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/apps/mobile/src/runtime/AppProviders.tsx b/apps/mobile/src/runtime/AppProviders.tsx
index 45d3a09..82c7dc1 100644
--- a/apps/mobile/src/runtime/AppProviders.tsx
+++ b/apps/mobile/src/runtime/AppProviders.tsx
@@ -94,7 +94,10 @@ export function AppProviders({ runtime, lockScreen, children }: AppProvidersProp
             {!ready ? (
               <Splash />
             ) : locked ? (
-              (lockScreen ?? <Splash />)
+              <>
+                <Fragment key={containerKey}>{children}</Fragment>
+                {lockScreen ?? <Splash />}
+              </>
             ) : (
               <Fragment key={containerKey}>{children}</Fragment>
             )}
diff --git a/platform/lifecycle/src/lock-store.ts b/platform/lifecycle/src/lock-store.ts
index ac906ce..880a517 100644
--- a/platform/lifecycle/src/lock-store.ts
+++ b/platform/lifecycle/src/lock-store.ts
@@ -37,7 +37,7 @@ export function createLockStore(deps: LockStoreDeps = {}): LockStore {
       lock: (reason) => {
         const { pinSet, isLocked } = get();
         if (!pinSet || isLocked) return;
-        set({ isLocked: true });
+        set({ isLocked: true, pinSet });
         bus.emit('lock.locked', { reason });
       },
       unlock: (method) => {
-- 

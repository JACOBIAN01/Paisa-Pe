{
  "name": "paisape-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "test": "jest",
    "cycles": "depcruise contracts core platform mockplatform services features design-system apps harness tools --config .dependency-cruiser.cjs",
    "loc": "tsx tools/loc/index.ts",
    "gen": "tsx tools/gen/index.ts",
    "inject": "tsx tools/inject/index.ts",
    "checks": "tsx tools/checks/index.ts",
    "format": "prettier --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm cycles"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.0",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "dependency-cruiser": "^16.8.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-boundaries": "^4.2.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.18",
    "prettier": "^3.4.2",
    "react-test-renderer": "19.1.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "zustand": "^5.0.16"
  }
}

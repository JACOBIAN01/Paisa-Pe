{
  "expo": {
    "name": "PaisaPe",
    "slug": "paisape",
    "scheme": "paisape",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": { "bundleIdentifier": "app.paisape.mobile", "supportsTablet": false },
    "android": { "package": "app.paisape.mobile" },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": { "tsconfigPaths": true }
  }
}
